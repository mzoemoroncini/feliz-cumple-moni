<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Feliz cumpleaños, mi amor ❤️</title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  >

  <style>

    :root {
      --rosa-1: #ffd8e0;
      --rosa-2: #f4a7b5;
      --rosa-3: #e7b9c7;
      --rosa-4: #fff0f3;

      --verde: #6f8066;
      --verde-oscuro: #56664f;

      --texto: #4f4548;
      --destacado: #8c5966;

      --blanco-suave:
        rgba(255, 255, 255, 0.28);

      --borde-suave:
        rgba(255, 255, 255, 0.45);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;

      min-height: 100vh;

      overflow-x: hidden;

      font-family:
        "Poppins",
        sans-serif;

      color: var(--texto);

      background:
        linear-gradient(
          135deg,
          var(--rosa-1),
          var(--rosa-2),
          var(--rosa-3),
          var(--rosa-4)
        );

      background-size:
        400%
        400%;

      animation:
        fondoAnimado
        14s
        ease
        infinite;

      position: relative;
    }

    body.carta-abierta {
      overflow-y: auto;
    }

    button {
      font: inherit;
    }

    @keyframes fondoAnimado {

      0% {
        background-position:
          0%
          50%;
      }

      50% {
        background-position:
          100%
          50%;
      }

      100% {
        background-position:
          0%
          50%;
      }

    }


    /* =========================
       FONDO
    ========================= */

    .orbe {
      position: fixed;

      border-radius: 999px;

      pointer-events: none;

      z-index: 0;

      opacity: 0.22;

      filter: blur(4px);

      animation:
        moverOrbe
        12s
        ease-in-out
        infinite
        alternate;
    }

    .orbe-1 {
      width: 260px;
      height: 260px;

      top: -70px;
      left: -80px;

      background: white;
    }

    .orbe-2 {
      width: 340px;
      height: 340px;

      right: -120px;
      bottom: -120px;

      background: #ff91a8;

      animation-delay: 2s;
    }

    .orbe-3 {
      width: 170px;
      height: 170px;

      top: 42%;
      right: 7%;

      background: #fff4f7;

      animation-delay: 4s;
    }

    @keyframes moverOrbe {

      from {
        transform:
          translate3d(
            0,
            0,
            0
          )
          scale(1);
      }

      to {
        transform:
          translate3d(
            35px,
            45px,
            0
          )
          scale(1.14);
      }

    }


    /* =========================
       PANTALLA INICIAL
    ========================= */

    .inicio {
      position: fixed;

      inset: 0;

      z-index: 1000;

      display: flex;

      align-items: center;
      justify-content: center;

      padding: 24px;

      background:
        radial-gradient(
          circle at top,
          rgba(
            255,
            255,
            255,
            0.22
          ),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #f6b3c1,
          #e88fa3,
          #d9879d
        );

      transition:
        opacity 0.8s ease,
        visibility 0.8s ease,
        transform 0.8s ease;
    }

    .inicio.oculto {
      opacity: 0;

      visibility: hidden;

      transform:
        scale(1.04);

      pointer-events: none;
    }

    .inicio-contenido {
      width:
        min(
          100%,
          760px
        );

      text-align: center;

      opacity: 0;

      transform:
        translateY(30px)
        scale(0.96);

      animation:
        entradaInicio
        1s
        ease
        forwards;
    }

    @keyframes entradaInicio {

      to {
        opacity: 1;

        transform:
          translateY(0)
          scale(1);
      }

    }


    /* =========================
       CORAZÓN INICIAL
    ========================= */

    .corazon-principal {
      display: inline-block;

      font-size:
        clamp(
          74px,
          16vw,
          120px
        );

      filter:
        drop-shadow(
          0
          14px
          22px
          rgba(
            100,
            35,
            55,
            0.24
          )
        );

      animation:
        latido
        1.25s
        ease-in-out
        infinite;

      transform-origin: center;
    }

    @keyframes latido {

      0%,
      100% {
        transform:
          scale(1);
      }

      18% {
        transform:
          scale(1.13);
      }

      34% {
        transform:
          scale(1);
      }

      50% {
        transform:
          scale(1.18);
      }

      70% {
        transform:
          scale(1);
      }

    }


    /* =========================
       TEXTO INICIAL
    ========================= */

    .inicio-titulo {
      margin:
        18px
        0
        6px;

      font-family:
        "Great Vibes",
        cursive;

      font-weight: 400;

      font-size:
        clamp(
          58px,
          12vw,
          104px
        );

      line-height: 1;

      color: white;

      text-shadow:
        0
        6px
        20px
        rgba(
          94,
          41,
          55,
          0.18
        );
    }

    .inicio-texto {
      width:
        min(
          100%,
          580px
        );

      margin:
        12px
        auto
        30px;

      font-size:
        clamp(
          15px,
          3.8vw,
          18px
        );

      line-height: 1.6;

      color:
        rgba(
          255,
          255,
          255,
          0.94
        );
    }


    /* =========================
       BOTÓN
    ========================= */

    .boton-abrir {
      position: relative;

      z-index: 2;

      border: 0;

      border-radius: 999px;

      padding:
        16px
        30px;

      background: white;

      color: #ad5f73;

      font-weight: 600;

      font-size: 16px;

      cursor: pointer;

      touch-action: manipulation;

      -webkit-tap-highlight-color:
        transparent;

      box-shadow:
        0
        14px
        35px
        rgba(
          92,
          35,
          53,
          0.22
        );

      transition:
        transform 0.22s ease,
        box-shadow 0.22s ease;
    }

    .boton-abrir:hover {
      transform:
        translateY(-3px)
        scale(1.03);
    }

    .boton-abrir:active {
      transform:
        scale(0.97);

      box-shadow:
        0
        9px
        24px
        rgba(
          92,
          35,
          53,
          0.2
        );
    }

    .boton-abrir:focus-visible {
      outline:
        3px solid
        rgba(
          255,
          255,
          255,
          0.82
        );

      outline-offset: 5px;
    }


    /* =========================
       CARTA
    ========================= */

    .carta {
      position: relative;

      z-index: 10;

      display: none;

      justify-content: center;

      min-height: 100vh;

      width: 100%;

      padding:
        42px
        16px
        90px;
    }

    .carta.visible {
      display: flex;
    }

    .carta-contenido {
      position: relative;

      width:
        min(
          100%,
          940px
        );

      padding:
        52px
        50px
        62px;

      text-align: center;

      background:
        var(
          --blanco-suave
        );

      border:
        1px solid
        var(
          --borde-suave
        );

      border-radius: 38px;

      backdrop-filter:
        blur(18px);

      -webkit-backdrop-filter:
        blur(18px);

      box-shadow:
        0
        28px
        80px
        rgba(
          99,
          54,
          66,
          0.16
        );

      overflow: hidden;

      opacity: 0;

      transform:
        translateY(45px)
        scale(0.97);

      animation:
        aparecerCarta
        0.95s
        ease
        forwards;
    }

    @keyframes aparecerCarta {

      to {
        opacity: 1;

        transform:
          translateY(0)
          scale(1);
      }

    }


    /* BRILLO SOBRE LA CARTA */

    .carta-contenido::before {
      content: "";

      position: absolute;

      inset: 0;

      pointer-events: none;

      background:
        linear-gradient(
          120deg,
          transparent 0%,
          rgba(
            255,
            255,
            255,
            0.24
          )
          35%,
          transparent
          62%
        );

      transform:
        translateX(-100%);

      animation:
        brilloCarta
        5.5s
        ease-in-out
        infinite;
    }

    @keyframes brilloCarta {

      0%,
      65% {
        transform:
          translateX(-110%);
      }

      100% {
        transform:
          translateX(110%);
      }

    }


    /* =========================
       TÍTULO
    ========================= */

    .titulo {
      position: relative;

      z-index: 1;

      margin: 0;

      font-family:
        "Great Vibes",
        cursive;

      font-weight: 400;

      font-size:
        clamp(
          54px,
          9vw,
          92px
        );

      line-height: 1.08;

      color:
        var(--verde);

      opacity: 0;

      transform:
        translateY(-20px)
        scale(0.96);

      animation:
        entradaTitulo
        1s
        0.35s
        ease
        forwards;
    }

    @keyframes entradaTitulo {

      to {
        opacity: 1;

        transform:
          translateY(0)
          scale(1);
      }

    }


    /* =========================
       SEPARADOR
    ========================= */

    .separador {
      position: relative;

      z-index: 1;

      margin:
        12px
        0
        30px;

      font-size: 38px;

      opacity: 0;

      animation:
        aparecer
          0.7s
          0.85s
          ease
          forwards,

        latido
          1.4s
          1.5s
          ease-in-out
          infinite;
    }

    @keyframes aparecer {

      to {
        opacity: 1;
      }

    }


    /* =========================
       MENSAJES
    ========================= */

    .mensaje {
      position: relative;

      z-index: 1;

      width:
        min(
          100%,
          790px
        );

      margin:
        28px
        auto;

      padding:
        22px
        24px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.34
        );

      border-radius: 24px;

      background:
        rgba(
          255,
          255,
          255,
          0.20
        );

      box-shadow:
        0
        12px
        28px
        rgba(
          102,
          61,
          73,
          0.06
        );

      font-size:
        clamp(
          17px,
          2.1vw,
          21px
        );

      line-height: 1.8;

      opacity: 0;

      transform:
        translateY(34px)
        scale(0.98);

      transition:
        opacity 0.9s ease,
        transform 0.9s ease;
    }

    .mensaje.visible {
      opacity: 1;

      transform:
        translateY(0)
        scale(1);
    }

    .destacado {
      color:
        var(--destacado);

      font-weight: 600;
    }


    /* =========================
       FINAL
    ========================= */

    .final {
      position: relative;

      z-index: 1;

      margin-top: 48px;

      font-family:
        "Great Vibes",
        cursive;

      font-size:
        clamp(
          46px,
          7vw,
          76px
        );

      line-height: 1.16;

      color:
        var(
          --verde-oscuro
        );

      opacity: 0;

      transform:
        scale(0.9)
        translateY(16px);

      transition:
        opacity 1.1s ease,
        transform
          1.1s
          cubic-bezier(
            0.16,
            1,
            0.3,
            1
          );
    }

    .final.visible {
      opacity: 1;

      transform:
        scale(1)
        translateY(0);
    }

    .corazon-final {
      display: block;

      margin-top: 14px;

      font-size: 62px;

      animation:
        latidoFinal
        1.15s
        ease-in-out
        infinite;
    }

    @keyframes latidoFinal {

      0%,
      100% {
        transform:
          scale(1);
      }

      50% {
        transform:
          scale(1.22);
      }

    }


    /* =========================
       CORAZONES FLOTANTES
    ========================= */

    .corazon-flotante {
      position: fixed;

      bottom: -70px;

      z-index: 4;

      pointer-events: none;

      user-select: none;

      animation:
        subirCorazon
        linear
        forwards;

      filter:
        drop-shadow(
          0
          5px
          8px
          rgba(
            0,
            0,
            0,
            0.07
          )
        );
    }

    @keyframes subirCorazon {

      0% {
        opacity: 0;

        transform:
          translate3d(
            0,
            0,
            0
          )
          rotate(0deg)
          scale(0.8);
      }

      10% {
        opacity: 0.86;
      }

      50% {
        transform:
          translate3d(
            18px,
            -55vh,
            0
          )
          rotate(160deg)
          scale(1);
      }

      100% {
        opacity: 0;

        transform:
          translate3d(
            -12px,
            -120vh,
            0
          )
          rotate(360deg)
          scale(0.82);
      }

    }


    /* =========================
       ESTRELLAS
    ========================= */

    .estrella {
      position: fixed;

      z-index: 1;

      pointer-events: none;

      user-select: none;

      animation:
        brillar
        ease-in-out
        infinite
        alternate;
    }

    @keyframes brillar {

      from {
        opacity: 0.18;

        transform:
          scale(0.65)
          rotate(0deg);
      }

      to {
        opacity: 0.86;

        transform:
          scale(1.22)
          rotate(22deg);
      }

    }


    /* =========================
       PARTÍCULAS
    ========================= */

    .particula {
      position: fixed;

      z-index: 20;

      width: 6px;
      height: 6px;

      border-radius: 999px;

      background:
        rgba(
          255,
          255,
          255,
          0.86
        );

      pointer-events: none;

      animation:
        particulaAnimacion
        1.2s
        ease-out
        forwards;
    }

    @keyframes particulaAnimacion {

      from {
        opacity: 1;

        transform:
          translate3d(
            0,
            0,
            0
          )
          scale(1);
      }

      to {
        opacity: 0;

        transform:
          translate3d(
            var(--dx),
            var(--dy),
            0
          )
          scale(0);
      }

    }


    /* =========================
       CELULAR
    ========================= */

    @media (max-width: 650px) {

      .inicio {
        padding: 18px;
      }

      .carta {
        padding:
          22px
          10px
          60px;
      }

      .carta-contenido {
        padding:
          34px
          16px
          44px;

        border-radius: 26px;
      }

      .mensaje {
        margin:
          22px
          auto;

        padding:
          19px
          17px;

        border-radius: 19px;

        line-height: 1.68;
      }

      .separador {
        margin-bottom: 22px;
      }

      .final {
        margin-top: 38px;
      }

    }


    /* Accesibilidad */

    @media (
      prefers-reduced-motion:
      reduce
    ) {

      *,
      *::before,
      *::after {
        animation-duration:
          0.01ms
          !important;

        animation-iteration-count:
          1
          !important;

        transition-duration:
          0.01ms
          !important;

        scroll-behavior:
          auto
          !important;
      }

    }

  </style>
</head>


<body>

  <div class="orbe orbe-1"></div>

  <div class="orbe orbe-2"></div>

  <div class="orbe orbe-3"></div>


  <!-- =========================
       INICIO
  ========================== -->

  <section
    id="inicio"
    class="inicio"
  >

    <div class="inicio-contenido">

      <div
        class="corazon-principal"
        aria-hidden="true"
      >
        ❤️
      </div>

      <h1 class="inicio-titulo">
        Para vos
      </h1>

      <p class="inicio-texto">
        Preparé algo chiquito
        para una persona enorme
        en mi vida.
      </p>

      <button
        id="btnAbrir"
        class="boton-abrir"
        type="button"
      >
        Abrir mi regalo ❤️
      </button>

    </div>

  </section>


  <!-- =========================
       CARTA
  ========================== -->

  <main
    id="carta"
    class="carta"
  >

    <section class="carta-contenido">

      <h1 class="titulo">
        Feliz cumpleaños mi amor
      </h1>

      <div
        class="separador"
        aria-hidden="true"
      >
        ❤️
      </div>


      <div class="mensaje">

        Sinceramente espero
        que pases un día hermoso.

        <br><br>

        <span class="destacado">
          Te merecés todas las
          cosas lindas del mundo
          y mucho más.
        </span>

      </div>


      <div class="mensaje">

        Agradezco a todo por
        haberte puesto en mi vida
        y poder celebrar este día
        que para mí antes era
        simplemente un día más.

      </div>


      <div class="mensaje">

        Sos todo lo que una
        persona puede desear.

        <br><br>

        <span class="destacado">
          Ojalá estés conmigo
          para siempre y un día más,
        </span>

        en esta y en todas las
        vidas que tengamos.

      </div>


      <div class="mensaje">

        Ni estando toda la eternidad
        con vos va a ser suficiente
        el tiempo.

        <br><br>

        <span class="destacado">
          Gracias, gracias y gracias
          por ser vos.
        </span>

        ❤️

      </div>


      <div class="final">

        Te amo con toda mi eternidad

        <span
          class="corazon-final"
          aria-hidden="true"
        >
          💚
        </span>

      </div>

    </section>

  </main>


  <script>

    "use strict";


    document.addEventListener(
      "DOMContentLoaded",
      function () {


        const btnAbrir =
          document.getElementById(
            "btnAbrir"
          );


        const inicio =
          document.getElementById(
            "inicio"
          );


        const carta =
          document.getElementById(
            "carta"
          );


        const mensajes =
          document.querySelectorAll(
            ".mensaje"
          );


        const final =
          document.querySelector(
            ".final"
          );


        const corazones = [
          "❤️",
          "💖",
          "💕",
          "💗",
          "💚",
          "💞"
        ];


        let cartaAbierta =
          false;


        let intervaloCorazones =
          null;


        let finalActivado =
          false;



        /* =========================
           VERIFICACIÓN
        ========================== */


        if (
          !btnAbrir ||
          !inicio ||
          !carta
        ) {

          console.error(
            "No se encontraron los elementos principales."
          );

          return;
        }



        /* =========================
   EVENTO DEL BOTÓN
========================= */

btnAbrir.addEventListener(
  "click",
  abrirCarta
);


/* =========================
   ABRIR CARTA
========================= */

function abrirCarta() {

  if (cartaAbierta) {
    return;
  }

  cartaAbierta = true;

  btnAbrir.disabled = true;

  inicio.classList.add("oculto");

  setTimeout(function () {

    carta.classList.add("visible");

    document.body.classList.add("carta-abierta");

    iniciarExperiencia();

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }, 550);

}


/* =========================
   INICIAR EXPERIENCIA
========================= */

function iniciarExperiencia() {

  crearEstrellas();

  crearExplosionInicial();

  for (let i = 0; i < 8; i++) {

    setTimeout(
      crearCorazon,
      i * 180
    );

  }

  intervaloCorazones =
    setInterval(
      crearCorazon,
      1100
    );

  observarContenido();

}


/* =========================
   CREAR CORAZÓN
========================= */

function crearCorazon() {

  const corazon =
    document.createElement("div");

  corazon.className =
    "corazon-flotante";

  corazon.textContent =
    corazones[
      Math.floor(
        Math.random() * corazones.length
      )
    ];

  corazon.style.left =
    Math.random() * 100 + "vw";

  corazon.style.fontSize =
    18 + Math.random() * 28 + "px";

  const duracion =
    8 + Math.random() * 7;

  corazon.style.animationDuration =
    duracion + "s";

  document.body.appendChild(corazon);

  setTimeout(function () {

    corazon.remove();

  }, duracion * 1000 + 500);

}


/* =========================
   ESTRELLAS
========================= */

function crearEstrellas() {

  const cantidad =
    window.innerWidth <= 650
      ? 18
      : 28;

  for (let i = 0; i < cantidad; i++) {

    const estrella =
      document.createElement("div");

    estrella.className =
      "estrella";

    estrella.textContent = "✨";

    estrella.style.top =
      Math.random() * 100 + "vh";

    estrella.style.left =
      Math.random() * 100 + "vw";

    estrella.style.fontSize =
      10 + Math.random() * 16 + "px";

    estrella.style.animationDuration =
      2 + Math.random() * 4 + "s";

    estrella.style.animationDelay =
      Math.random() * 2 + "s";

    document.body.appendChild(estrella);

  }

}


/* =========================
   MENSAJES AL SCROLL
========================= */

function observarContenido() {

  if ("IntersectionObserver" in window) {

    const observador =
      new IntersectionObserver(
        function (entradas, observer) {

          entradas.forEach(function (entrada) {

            if (!entrada.isIntersecting) {
              return;
            }

            entrada.target.classList.add(
              "visible"
            );

            if (
              entrada.target.classList.contains(
                "final"
              )
            ) {
              activarFinal();
            }

            observer.unobserve(
              entrada.target
            );

          });

        },
        {
          threshold: 0.18
        }
      );

    mensajes.forEach(function (mensaje) {
      observador.observe(mensaje);
    });

    if (final) {
      observador.observe(final);
    }

    return;
  }

  mensajes.forEach(function (mensaje, indice) {

    setTimeout(function () {

      mensaje.classList.add("visible");

    }, 500 + indice * 500);

  });

  if (final) {

    setTimeout(function () {

      final.classList.add("visible");

      activarFinal();

    }, 2800);

  }

}


/* =========================
   EXPLOSIÓN INICIAL
========================= */

function crearExplosionInicial() {

  const x = window.innerWidth / 2;
  const y = window.innerHeight / 2;

  for (let i = 0; i < 18; i++) {

    setTimeout(function () {

      crearParticula(x, y);

    }, i * 35);

  }

}


/* =========================
   PARTÍCULAS
========================= */

function crearParticula(x, y) {

  const particula =
    document.createElement("div");

  particula.className = "particula";

  particula.style.left = x + "px";
  particula.style.top = y + "px";

  const angulo =
    Math.random() * Math.PI * 2;

  const distancia =
    30 + Math.random() * 90;

  const dx =
    Math.cos(angulo) * distancia;

  const dy =
    Math.sin(angulo) * distancia;

  particula.style.setProperty(
    "--dx",
    dx + "px"
  );

  particula.style.setProperty(
    "--dy",
    dy + "px"
  );

  document.body.appendChild(particula);

  setTimeout(function () {

    particula.remove();

  }, 1400);

}


/* =========================
   FINAL
========================= */

function activarFinal() {

  if (finalActivado) {
    return;
  }

  finalActivado = true;

  for (let i = 0; i < 28; i++) {

    setTimeout(
      crearCorazon,
      i * 75
    );

  }

}


/* =========================
   DESTELLOS AL TOCAR
========================= */

document.addEventListener(
  "pointerdown",
  function (evento) {

    if (!cartaAbierta) {
      return;
    }

    for (let i = 0; i < 5; i++) {

      crearParticula(
        evento.clientX,
        evento.clientY
      );

    }

  }
);


/* =========================
   LIMPIEZA
========================= */

window.addEventListener(
  "beforeunload",
  function () {

    if (intervaloCorazones) {

      clearInterval(
        intervaloCorazones
      );

    }

  }
);